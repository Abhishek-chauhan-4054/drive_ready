# Everything is optional — the site runs with no environment variables at all.

# Public URL of this app (canonical links, sitemap.xml, robots.txt).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://driveready.pytron.in

# Company website linked in the header, footer, About and Contact pages.
NEXT_PUBLIC_COMPANY_URL=https://digital.pytron.in

# Contact email shown on /contact and in the footer (default: business@pytron.io).
NEXT_PUBLIC_CONTACT_EMAIL=business@pytron.io

# Google Analytics 4. When set, GA4 loads and app events (practice_started, mock_test_completed, …)
# are sent to it automatically. The privacy page updates itself.
NEXT_PUBLIC_GA4_ID=

# Optional override: none | console | gtag | plausible (defaults to gtag when GA4 ID is set).
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Content source: local (default). A "supabase" provider can be added later — see CONTENT.md.
CONTENT_PROVIDER=local
